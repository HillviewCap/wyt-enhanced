generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Datasource {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  uuid                String              @unique @db.Uuid
  name                String              @db.VarChar(255)
  definition          String?
  interface           String?             @db.VarChar(100)
  type                String?             @db.VarChar(50)
  hardware            String?             @db.VarChar(255)
  createdAt           DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  device_locations    DeviceLocation[]    @ignore
  packets             Packet[]            @ignore
  signal_measurements SignalMeasurement[] @ignore

  @@index([createdAt], map: "idx_datasources_created_at")
  @@index([name], map: "idx_datasources_name")
  @@index([uuid], map: "idx_datasources_uuid")
  @@map("datasources")
}

model Device {
  id              String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key             String                  @unique @db.VarChar(255)
  macaddr         Unsupported("macaddr")?
  phyname         String?                 @db.VarChar(100)
  devname         String?                 @db.VarChar(100)
  type            String?                 @db.VarChar(50)
  basicType       String?                 @map("basic_type") @db.VarChar(50)
  cryptSet        String?                 @map("crypt_set")
  basicCryptSet   String?                 @map("basic_crypt_set") @db.VarChar(100)
  firstTime       DateTime?               @map("first_time") @db.Timestamptz(6)
  lastTime        DateTime?               @map("last_time") @db.Timestamptz(6)
  packetsTotal    BigInt?                 @default(0) @map("packets_total")
  packetsRx       BigInt?                 @default(0) @map("packets_rx")
  packetsTx       BigInt?                 @default(0) @map("packets_tx")
  dataSize        BigInt?                 @default(0) @map("data_size")
  channel         String?                 @db.VarChar(20)
  frequency       Int?
  manuf           String?                 @db.VarChar(255)
  model           String?                 @db.VarChar(255)
  mod_time        DateTime?               @db.Timestamptz(6)
  serverUuid      String?                 @map("server_uuid") @db.Uuid
  location        Json?
  latitude        Decimal?                @db.Decimal(10, 8)
  longitude       Decimal?                @db.Decimal(11, 8)
  altitude        Decimal?                @db.Decimal(8, 2)
  minLatitude     Decimal?                @map("min_latitude") @db.Decimal(10, 8)
  maxLatitude     Decimal?                @map("max_latitude") @db.Decimal(10, 8)
  minLongitude    Decimal?                @map("min_longitude") @db.Decimal(11, 8)
  maxLongitude    Decimal?                @map("max_longitude") @db.Decimal(11, 8)
  signalData      Json?                   @map("signal_data")
  createdAt       DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  analysisResults AnalysisResult[]
  sightings       Sighting[]

  @@index([basicType], map: "idx_devices_basic_type")
  @@index([channel], map: "idx_devices_channel")
  @@index([firstTime], map: "idx_devices_first_time")
  @@index([frequency], map: "idx_devices_frequency")
  @@index([key], map: "idx_devices_key")
  @@index([lastTime], map: "idx_devices_last_time")
  @@index([location], map: "idx_devices_location_gin", type: Gin)
  @@index([macaddr], map: "idx_devices_macaddr")
  @@index([manuf], map: "idx_devices_manuf")
  @@index([serverUuid], map: "idx_devices_server_uuid")
  @@index([signalData], map: "idx_devices_signal_data_gin", type: Gin)
  @@index([type], map: "idx_devices_type")
  @@map("devices")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Packet {
  id             String?                 @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ts             DateTime                @db.Timestamptz(6)
  deviceKey      String?                 @map("device_key") @db.VarChar(255)
  datasourceUuid String?                 @map("datasource_uuid") @db.Uuid
  packetType     String?                 @map("packet_type") @db.VarChar(50)
  subType        String?                 @map("sub_type") @db.VarChar(50)
  sourceMac      Unsupported("macaddr")? @map("source_mac")
  destMac        Unsupported("macaddr")? @map("dest_mac")
  bssid          Unsupported("macaddr")?
  size           Int?
  frequency      Int?
  channel        String?                 @db.VarChar(20)
  signalDbm      Int?                    @map("signal_dbm")
  noiseDbm       Int?                    @map("noise_dbm")
  snr            Decimal?                @db.Decimal(5, 2)
  retry          Boolean?                @default(false)
  wep            Boolean?                @default(false)
  fragmented     Boolean?                @default(false)
  dataPayload    Bytes?                  @map("data_payload")
  dot11Info      Json?                   @map("dot11_info")
  location       Json?
  latitude       Decimal?                @db.Decimal(10, 8)
  longitude      Decimal?                @db.Decimal(11, 8)
  altitude       Decimal?                @db.Decimal(8, 2)
  createdAt      DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  packet_hash    String?
  datasources    Datasource?             @relation(fields: [datasourceUuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)

  @@index([bssid], map: "idx_packets_bssid")
  @@index([channel], map: "idx_packets_channel")
  @@index([datasourceUuid, ts], map: "idx_packets_datasource_ts")
  @@index([datasourceUuid], map: "idx_packets_datasource_uuid")
  @@index([destMac], map: "idx_packets_dest_mac")
  @@index([deviceKey], map: "idx_packets_device_key")
  @@index([deviceKey, ts], map: "idx_packets_device_ts")
  @@index([dot11Info], map: "idx_packets_dot11_info_gin", type: Gin)
  @@index([frequency], map: "idx_packets_frequency")
  @@index([packet_hash], map: "idx_packets_hash")
  @@index([packet_hash, ts], map: "idx_packets_hash_ts")
  @@index([location], map: "idx_packets_location_gin", type: Gin)
  @@index([packetType], map: "idx_packets_packet_type")
  @@index([sourceMac], map: "idx_packets_source_mac")
  @@index([ts], map: "idx_packets_ts_brin", type: Brin)
  @@index([packetType, ts], map: "idx_packets_type_ts")
  @@map("packets")
  @@ignore
}

model ProcessingState {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filePath         String    @unique @map("file_path")
  fileName         String    @map("file_name") @db.VarChar(255)
  fileSize         BigInt?   @map("file_size")
  fileHash         String?   @map("file_hash") @db.VarChar(64)
  processingStatus String    @default("pending") @map("processing_status") @db.VarChar(50)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  errorMessage     String?   @map("error_message")
  recordsProcessed Int?      @default(0) @map("records_processed")
  recordsSkipped   Int?      @default(0) @map("records_skipped")
  metadata         Json?
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([completedAt], map: "idx_processing_state_completed_at")
  @@index([createdAt], map: "idx_processing_state_created_at")
  @@index([fileName], map: "idx_processing_state_file_name")
  @@index([filePath], map: "idx_processing_state_file_path")
  @@index([metadata], map: "idx_processing_state_metadata_gin", type: Gin)
  @@index([startedAt], map: "idx_processing_state_started_at")
  @@index([processingStatus], map: "idx_processing_state_status")
  @@map("processing_state")
}

model WifiNetwork {
  id             String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bssid          Unsupported("macaddr") @unique(map: "wifi_networks_bssid_unique")
  ssid           String?                @db.VarChar(32)
  ssidHash       String?                @map("ssid_hash") @db.VarChar(64)
  securityType   String?                @map("security_type") @db.VarChar(50)
  encryption     String?                @db.VarChar(50)
  channel        Int?
  frequency      Int?
  signalStrength Int?                   @map("signal_strength")
  firstSeen      DateTime?              @map("first_seen") @db.Timestamptz(6)
  lastSeen       DateTime?              @map("last_seen") @db.Timestamptz(6)
  timesSeen      Int?                   @default(1) @map("times_seen")
  vendor         String?                @db.VarChar(255)
  location       Json?
  latitude       Decimal?               @db.Decimal(10, 8)
  longitude      Decimal?               @db.Decimal(11, 8)
  altitude       Decimal?               @db.Decimal(8, 2)
  capabilities   String?
  beaconInterval Int?                   @map("beacon_interval")
  dtimPeriod     Int?                   @map("dtim_period")
  networkType    String?                @map("network_type") @db.VarChar(20)
  createdAt      DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clients        WifiClient[]

  @@index([bssid], map: "idx_wifi_networks_bssid")
  @@index([channel], map: "idx_wifi_networks_channel")
  @@index([channel, signalStrength], map: "idx_wifi_networks_channel_signal")
  @@index([firstSeen], map: "idx_wifi_networks_first_seen")
  @@index([frequency], map: "idx_wifi_networks_frequency")
  @@index([lastSeen], map: "idx_wifi_networks_last_seen")
  @@index([location], map: "idx_wifi_networks_location_gin", type: Gin)
  @@index([securityType, signalStrength], map: "idx_wifi_networks_security_signal")
  @@index([securityType], map: "idx_wifi_networks_security_type")
  @@index([signalStrength], map: "idx_wifi_networks_signal_strength")
  @@index([vendor], map: "idx_wifi_networks_vendor")
  @@index([vendor, signalStrength], map: "idx_wifi_networks_vendor_signal")
  @@map("wifi_networks")
}

model WifiClient {
  id              String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clientMac       Unsupported("macaddr")  @unique(map: "wifi_clients_client_mac_unique") @map("client_mac")
  networkBssid    Unsupported("macaddr")? @map("network_bssid")
  clientType      String?                 @map("client_type") @db.VarChar(50)
  associationType String?                 @map("association_type") @db.VarChar(50)
  firstSeen       DateTime?               @map("first_seen") @db.Timestamptz(6)
  lastSeen        DateTime?               @map("last_seen") @db.Timestamptz(6)
  packetsTotal    Int?                    @default(0) @map("packets_total")
  dataBytes       BigInt?                 @default(0) @map("data_bytes")
  vendor          String?                 @db.VarChar(255)
  signalStrength  Int?                    @map("signal_strength")
  location        Json?
  latitude        Decimal?                @db.Decimal(10, 8)
  longitude       Decimal?                @db.Decimal(11, 8)
  altitude        Decimal?                @db.Decimal(8, 2)
  dhcpHostname    String?                 @map("dhcp_hostname") @db.VarChar(255)
  dhcpVendor      String?                 @map("dhcp_vendor") @db.VarChar(255)
  userAgent       String?                 @map("user_agent")
  createdAt       DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  network         WifiNetwork?            @relation(fields: [networkBssid], references: [bssid], onDelete: NoAction, onUpdate: NoAction)

  @@index([firstSeen], map: "idx_wifi_clients_first_seen")
  @@index([lastSeen], map: "idx_wifi_clients_last_seen")
  @@index([clientMac], map: "idx_wifi_clients_mac")
  @@index([clientMac, networkBssid], map: "idx_wifi_clients_mac_network")
  @@index([networkBssid], map: "idx_wifi_clients_network_bssid")
  @@index([networkBssid, lastSeen], map: "idx_wifi_clients_network_time")
  @@index([signalStrength], map: "idx_wifi_clients_signal_strength")
  @@index([clientType], map: "idx_wifi_clients_type")
  @@index([vendor], map: "idx_wifi_clients_vendor")
  @@map("wifi_clients")
}

model BluetoothDevice {
  id               String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bdAddress        Unsupported("macaddr") @unique(map: "bluetooth_devices_address_unique") @map("bd_address")
  deviceName       String?                @map("device_name") @db.VarChar(248)
  deviceType       String?                @map("device_type") @db.VarChar(50)
  deviceClass      Int?                   @map("device_class")
  manufacturerId   Int?                   @map("manufacturer_id")
  manufacturerData Bytes?                 @map("manufacturer_data")
  txPower          Int?                   @map("tx_power")
  rssi             Int?
  firstSeen        DateTime?              @map("first_seen") @db.Timestamptz(6)
  lastSeen         DateTime?              @map("last_seen") @db.Timestamptz(6)
  timesSeen        Int?                   @default(1) @map("times_seen")
  vendor           String?                @db.VarChar(255)
  location         Json?
  latitude         Decimal?               @db.Decimal(10, 8)
  longitude        Decimal?               @db.Decimal(11, 8)
  altitude         Decimal?               @db.Decimal(8, 2)
  isRandomAddress  Boolean?               @default(false) @map("is_random_address")
  createdAt        DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  services         BluetoothService[]

  @@index([bdAddress], map: "idx_bluetooth_devices_address")
  @@index([firstSeen], map: "idx_bluetooth_devices_first_seen")
  @@index([lastSeen], map: "idx_bluetooth_devices_last_seen")
  @@index([manufacturerId], map: "idx_bluetooth_devices_manufacturer")
  @@index([rssi], map: "idx_bluetooth_devices_rssi")
  @@index([deviceType], map: "idx_bluetooth_devices_type")
  @@index([vendor], map: "idx_bluetooth_devices_vendor")
  @@map("bluetooth_devices")
}

model BluetoothService {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  deviceId            String          @map("device_id") @db.Uuid
  serviceUuid         String          @map("service_uuid") @db.Uuid
  serviceName         String?         @map("service_name") @db.VarChar(255)
  serviceType         String?         @map("service_type") @db.VarChar(50)
  characteristicCount Int?            @default(0) @map("characteristic_count")
  firstSeen           DateTime?       @map("first_seen") @db.Timestamptz(6)
  lastSeen            DateTime?       @map("last_seen") @db.Timestamptz(6)
  serviceData         Bytes?          @map("service_data")
  createdAt           DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  device              BluetoothDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([deviceId, serviceUuid], map: "bluetooth_services_device_service_unique")
  @@index([deviceId], map: "idx_bluetooth_services_device_id")
  @@index([firstSeen], map: "idx_bluetooth_services_first_seen")
  @@index([serviceName], map: "idx_bluetooth_services_name")
  @@index([serviceUuid], map: "idx_bluetooth_services_uuid")
  @@map("bluetooth_services")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model DeviceLocation {
  id             String?                 @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  deviceKey      String                  @map("device_key") @db.VarChar(255)
  deviceMac      Unsupported("macaddr")? @map("device_mac")
  timestamp      DateTime                @db.Timestamptz(6)
  latitude       Decimal                 @db.Decimal(10, 8)
  longitude      Decimal                 @db.Decimal(11, 8)
  altitude       Decimal?                @db.Decimal(8, 2)
  accuracy       Decimal?                @db.Decimal(6, 2)
  speed          Decimal?                @db.Decimal(6, 2)
  heading        Decimal?                @db.Decimal(5, 1)
  locationSource String?                 @map("location_source") @db.VarChar(50)
  signalStrength Int?                    @map("signal_strength")
  datasourceUuid String?                 @map("datasource_uuid") @db.Uuid
  createdAt      DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  datasources    Datasource?             @relation(fields: [datasourceUuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)

  @@index([latitude, longitude], map: "idx_device_locations_coords")
  @@index([datasourceUuid], map: "idx_device_locations_datasource")
  @@index([deviceKey, latitude, longitude, timestamp], map: "idx_device_locations_device_coords_time")
  @@index([deviceKey], map: "idx_device_locations_device_key")
  @@index([deviceMac], map: "idx_device_locations_device_mac")
  @@index([deviceKey, timestamp], map: "idx_device_locations_device_time")
  @@index([timestamp], map: "idx_device_locations_timestamp")
  @@index([timestamp], map: "idx_device_locations_timestamp_brin", type: Brin)
  @@map("device_locations")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model SignalMeasurement {
  id              String?                 @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  deviceKey       String?                 @map("device_key") @db.VarChar(255)
  deviceMac       Unsupported("macaddr")? @map("device_mac")
  targetMac       Unsupported("macaddr")? @map("target_mac")
  measurementType String?                 @map("measurement_type") @db.VarChar(50)
  signalDbm       Int?                    @map("signal_dbm")
  noiseDbm        Int?                    @map("noise_dbm")
  snr             Decimal?                @db.Decimal(5, 2)
  timestamp       DateTime                @db.Timestamptz(6)
  latitude        Decimal?                @db.Decimal(10, 8)
  longitude       Decimal?                @db.Decimal(11, 8)
  altitude        Decimal?                @db.Decimal(8, 2)
  frequency       Int?
  channel         String?                 @db.VarChar(20)
  datasourceUuid  String?                 @map("datasource_uuid") @db.Uuid
  createdAt       DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  datasources     Datasource?             @relation(fields: [datasourceUuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel], map: "idx_signal_measurements_channel")
  @@index([deviceKey], map: "idx_signal_measurements_device_key")
  @@index([deviceMac], map: "idx_signal_measurements_device_mac")
  @@index([deviceMac, targetMac], map: "idx_signal_measurements_device_target")
  @@index([frequency], map: "idx_signal_measurements_frequency")
  @@index([signalDbm], map: "idx_signal_measurements_signal_dbm")
  @@index([targetMac], map: "idx_signal_measurements_target_mac")
  @@index([targetMac, timestamp], map: "idx_signal_measurements_target_time")
  @@index([timestamp], map: "idx_signal_measurements_timestamp_brin", type: Brin)
  @@index([measurementType], map: "idx_signal_measurements_type")
  @@map("signal_measurements")
  @@ignore
}

model WardrivingSession {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionName        String?   @map("session_name") @db.VarChar(255)
  startTime          DateTime  @map("start_time") @db.Timestamptz(6)
  endTime            DateTime? @map("end_time") @db.Timestamptz(6)
  totalDistance      Decimal?  @map("total_distance") @db.Decimal(10, 2)
  areaCovered        Decimal?  @map("area_covered") @db.Decimal(12, 2)
  devicesDiscovered  Int?      @default(0) @map("devices_discovered")
  networksDiscovered Int?      @default(0) @map("networks_discovered")
  datasourceUuids    String[]  @map("datasource_uuids") @db.Uuid
  routeGeojson       Json?     @map("route_geojson")
  metadata           Json?
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([datasourceUuids], map: "idx_wardriving_sessions_datasources_gin", type: Gin)
  @@index([metadata], map: "idx_wardriving_sessions_metadata_gin", type: Gin)
  @@index([sessionName], map: "idx_wardriving_sessions_name")
  @@index([routeGeojson], map: "idx_wardriving_sessions_route_gin", type: Gin)
  @@index([startTime], map: "idx_wardriving_sessions_start_time")
  @@map("wardriving_sessions")
}

model DriveSession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionName        String?  @map("session_name") @db.VarChar(255)
  startTime          DateTime @map("start_time") @db.Timestamptz(6)
  endTime            DateTime @map("end_time") @db.Timestamptz(6)
  totalDistanceM     Decimal? @map("total_distance_m") @db.Decimal(10, 2)
  avgSpeedKmh        Decimal? @map("avg_speed_kmh") @db.Decimal(5, 2)
  maxSpeedKmh        Decimal? @map("max_speed_kmh") @db.Decimal(5, 2)
  networksDiscovered Int      @default(0) @map("networks_discovered")
  clientsDiscovered  Int      @default(0) @map("clients_discovered")
  routeGeojson       Json?    @map("route_geojson")
  startLatitude      Decimal? @map("start_latitude") @db.Decimal(10, 8)
  startLongitude     Decimal? @map("start_longitude") @db.Decimal(11, 8)
  endLatitude        Decimal? @map("end_latitude") @db.Decimal(10, 8)
  endLongitude       Decimal? @map("end_longitude") @db.Decimal(11, 8)
  detectionMethod    String   @default("gps_clustering") @map("detection_method") @db.VarChar(50)
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([startTime])
  @@index([endTime])
  @@map("drive_sessions")
}

model Snapshot {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ts_sec    Int
  ts_usec   Int       @default(0)
  ts        DateTime? @default(dbgenerated("to_timestamp((((ts_sec)::numeric + ((ts_usec)::numeric / 1000000.0)))::double precision)")) @db.Timestamptz(6)
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  altitude  Decimal?  @db.Decimal(8, 2)
  snaptype  String?   @db.VarChar(50)
  json_data Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([snaptype], map: "idx_snapshots_snaptype")
  @@index([ts], map: "idx_snapshots_ts", type: Brin)
  @@index([ts_sec], map: "idx_snapshots_ts_sec")
  @@map("snapshots")
}

model Sighting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  timestamp      DateTime @db.Timestamptz(6)
  latitude       Decimal  @db.Decimal(10, 8)
  longitude      Decimal  @db.Decimal(11, 8)
  altitude       Decimal? @db.Decimal(8, 2)
  signalStrength Int?     @map("signal_strength")
  accuracy       Decimal? @db.Decimal(6, 2)
  datasourceUuid String?  @map("datasource_uuid") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deviceId])
  @@index([timestamp])
  @@index([latitude, longitude])
  @@map("sightings")
}

model AnalysisResult {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId          String   @map("device_id") @db.Uuid
  persistenceScore  Decimal  @map("persistence_score") @db.Decimal(5, 2)
  analysisTimestamp DateTime @map("analysis_timestamp") @db.Timestamptz(6)
  locationCount     Int      @map("location_count")
  timeWindowHours   Int      @map("time_window_hours")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

